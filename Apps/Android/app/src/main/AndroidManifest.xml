<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android 12+: talk to paired devices. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Android 11 and older. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <!-- Latest firmware from the project's GitHub Pages site. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- "Remove this app" after a successful update. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true" />

    <!-- Lets the app see whether DMD Manage is installed. -->
    <queries>
        <package android:name="com.thorkracing.wireddevices" />
        <!-- Lets the app see whether LVM GEO is installed. -->
        <package android:name="com.lvm.mobile.du" />
    </queries>

    <application
        android:name=".MotoButtonsApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.MotoButtons">
        <!-- singleTop: the web page's "Open Moto Buttons" link reuses an open screen.
             configChanges: the controller's keyboard reconnecting after an update
             must not recreate the screen mid-task. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "Open Moto Buttons" on the setup web page: motobuttons://open -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="motobuttons" android:host="open" />
            </intent-filter>
        </activity>
        <!-- Nordic DFU transfer for the nRF52840 controller. -->
        <service
            android:name=".DfuService"
            android:exported="false" />
        <!-- Button C on the controller presses LVM GEO's GPS button. -->
        <service
            android:name=".LvmGeoService"
            android:exported="false"
            android:label="@string/lvm_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/lvm_geo_service" />
        </service>
    </application>
</manifest>
